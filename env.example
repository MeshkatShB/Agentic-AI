# Backend Configuration
SECRET_KEY=change-this-secret-key-in-production-please-use-a-long-random-string
# Use ./db/local_agent.db for Docker (mounted volume); or local_agent.db for local dev
DATABASE_URL=sqlite:///./db/local_agent.db

# Ollama Configuration (Default LLM Provider)
# For Docker: use http://host.docker.internal:11434 to access host's Ollama
# For local development: use http://127.0.0.1:11434
# For Docker Ollama service: use http://ollama:11434
OLLAMA_BASE_URL=http://host.docker.internal:11434
DEFAULT_MODEL=qwen3:latest
MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=2000

# External API Configuration (Optional)
# Note: API keys can be set here as environment variables (shared across all users)
# or configured per-user through the Settings UI (takes precedence).
# Users can choose between Ollama (local), OpenAI, DeepSeek, Mistral AI, or Google Gemini.
# Default endpoints (can be overridden in Settings):
# - OpenAI: https://api.openai.com/v1
# - DeepSeek: https://api.deepseek.com/v1
# - Mistral: https://api.mistral.ai/v1
# - Gemini: https://generativelanguage.googleapis.com/v1
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=

# Vector Storage Configuration
VECTOR_STORE=chroma  # Options: chroma, qdrant
CHROMA_PATH=./chroma_db
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=agent_memory
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu  # Options: auto, cpu, cuda, mps (use "cpu" for Docker without GPU, "auto" for auto-detection)

# File Access Configuration
ALLOWED_FILE_PATHS=./data,./documents
BLOCKED_FILE_PATHS=/etc,/system32,/Windows/System32
MAX_FILE_SIZE_MB=100

# Agent Configuration
MAX_STEPS_PER_REQUEST=10
MAX_TOKENS_PER_STEP=2000
STEP_TIMEOUT_SECONDS=30
REQUIRE_TOOL_CONFIRMATION=true

# Web Search Configuration (Optional)
ENABLE_WEB_SEARCH=false
SEARXNG_URL=http://localhost:8888
WEB_SEARCH_TIMEOUT=10

# CORS Configuration
# For Chrome extension access from different machines, use "*" to allow all origins
# Or specify exact origins: http://localhost:5173,http://localhost:3000,http://localhost:8080
# Chrome extensions use chrome-extension:// protocol which is handled automatically
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080
# For cross-machine access with Chrome extension, you may need: CORS_ORIGINS=*

# Telegram Bot (optional)
# Create a bot via @BotFather, then set token here. Only paired users (by pairing code) can use the bot.
ENABLE_TELEGRAM_BOT=false
TELEGRAM_BOT_TOKEN=

# LangSmith / LangChain tracing (optional)
# Set to false to disable; avoids 403 warnings if you don't use LangSmith.
# LANGCHAIN_TRACING_V2=false
# LANGSMITH_API_KEY=

# Development
DEBUG=false
